    {
      "ja": "しかし、後の研究はこの説明に慎重な見方を示しています。",
      "chunks": [
        {
          "en": "However,",
          "ja": "しかし",
          "role": "M"
        },
        {
          "en": "later studies",
          "ja": "後の研究は",
          "role": "S"
        },
        {
          "en": "show",
          "ja": "示しています",
          "role": "V"
        },
        {
