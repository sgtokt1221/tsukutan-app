  "title": "The Return of the Wolf",
  "titleJa": "オオカミが戻るとき",
  "sentences": [
    {
      "ja": "1995年、米国のある国立公園に14頭のオオカミが放されました。",
      "chunks": [
        {
          "en": "In 1995,",
          "ja": "1995年",
          "role": "M"
        },
        {
          "en": "fourteen wolves",
          "ja": "14頭のオオカミが",
          "role": "S"
        },
        {
          "en": "were released",
          "ja": "放されました",
          "role": "V"
        },
        {
          "en": "into a national park in the United States.",
          "ja": "米国のある国立公園に",
          "role": "M"
        }
      ]
    },
    {
      "ja": "その地域からオオカミが姿を消して、およそ70年が経っていました。",
      "chunks": [
        {
          "en": "About seventy years",
          "ja": "およそ70年が",
          "role": "S"
        },
        {
          "en": "had passed",
          "ja": "経っていました",
          "role": "V"
        },
        {
          "en": "since wolves had disappeared from that area.",
          "ja": "その地域からオオカミが姿を消して",
          "role": "M"
        }
      ]
    },
    {
      "ja": "目的は、増えすぎたシカの数を抑えることでした。",
      "chunks": [
        {
          "en": "The purpose",
          "ja": "目的は",
          "role": "S"
        },
        {
          "en": "was",
          "ja": "でした",
          "role": "V"
        },
        {
          "en": "to control the number of deer, which had increased too much.",
          "ja": "増えすぎたシカの数を抑えること",
          "role": "C"
        }
      ]
    },
    {
      "ja": "シカは若い木の芽を食べ尽くし、川岸の林が失われていました。",
      "chunks": [
        {
          "en": "The deer",
          "ja": "シカは",
          "role": "S"
        },
        {
          "en": "had eaten up",
          "ja": "食べ尽くしました",
          "role": "V"
        },
        {
          "en": "the buds of young trees,",
          "ja": "若い木の芽を",
          "role": "O"
        },
        {
          "en": "and the woods along the rivers had been lost.",
          "ja": "そして川岸の林が失われていました",
          "role": "M"
        }
      ]
    },
    {
      "ja": "オオカミが戻ると、シカの数は確かに減りました。",
      "chunks": [
        {
          "en": "When the wolves returned,",
          "ja": "オオカミが戻ると",
          "role": "M"
        },
        {
          "en": "the number of deer",
          "ja": "シカの数は",
          "role": "S"
        },
        {
          "en": "certainly fell.",
          "ja": "確かに減りました",
          "role": "V"
        }
      ]
    },
    {
      "ja": "しかし、より大きな変化は数ではなく行動に現れました。",
      "chunks": [
        {
          "en": "However,",
          "ja": "しかし",
          "role": "M"
        },
        {
          "en": "the larger change",
          "ja": "より大きな変化は",
          "role": "S"
        },
        {
          "en": "appeared",
          "ja": "現れました",
          "role": "V"
        },
        {
          "en": "in behavior, not in numbers.",
          "ja": "数ではなく行動に",
          "role": "M"
        }
      ]
    },
    {
      "ja": "シカは、逃げ場のない谷に長くとどまらなくなりました。",
      "chunks": [
        {
          "en": "The deer",
          "ja": "シカは",
          "role": "S"
        },
        {
          "en": "stopped staying",
          "ja": "とどまらなくなりました",
          "role": "V"
        },
        {
          "en": "long in valleys where there was no way to escape.",
          "ja": "逃げ場のない谷に",
          "role": "M"
        }
      ]
    },
    {
      "ja": "その結果、そこの木々が再び育ち始めました。",
      "chunks": [
        {
          "en": "As a result,",
          "ja": "その結果",
          "role": "M"
        },
        {
          "en": "the trees there",
          "ja": "そこの木々が",
          "role": "S"
        },
        {
          "en": "began to grow",
          "ja": "育ち始めました",
          "role": "V"
        },
        {
          "en": "again.",
          "ja": "再び",
          "role": "M"
        }
      ]
    },
    {
      "ja": "木が育つと、鳥が戻り、ビーバーが戻りました。",
      "chunks": [
        {
          "en": "When the trees grew,",
          "ja": "木が育つと",
          "role": "M"
        },
        {
          "en": "birds",
          "ja": "鳥が",
          "role": "S"
        },
        {
          "en": "returned,",
          "ja": "戻りました",
          "role": "V"
        },
        {
          "en": "and beavers returned.",
          "ja": "そしてビーバーが戻りました",
          "role": "M"
        }
      ]
    },
    {
      "ja": "ビーバーが作ったダムは、魚や虫の住む池を生みました。",
      "chunks": [
        {
          "en": "The dams the beavers made",
          "ja": "ビーバーが作ったダムは",
          "role": "S"
        },
        {
          "en": "produced",
          "ja": "生みました",
          "role": "V"
        },
        {
          "en": "ponds where fish and insects live.",
          "ja": "魚や虫の住む池を",
          "role": "O"
        }
      ]
    },
    {
      "ja": "川岸に根が張ったことで、川の形さえ変わったと報告されています。",
