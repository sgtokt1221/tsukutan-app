      "chunks": [
        {
          "en": "But",
          "ja": "しかし",
          "role": "M"
        },
        {
          "en": "if the cause is in another place,",
          "ja": "原因が別の場所にあるなら",
          "role": "M"
        },
        {
          "en": "that alone",
          "ja": "それだけでは",
          "role": "S"
        },
        {
          "en": "is not enough.",
          "ja": "足りません",
          "role": "V"
        }
      ]
    },
    {
      "ja": "見える問題と、その後ろにある問題を、同時に見る必要があります。",
      "chunks": [
        {
          "en": "We",
          "ja": "わたしたちは",
          "role": "S"
        },
        {
          "en": "need to see",
          "ja": "見る必要があります",
