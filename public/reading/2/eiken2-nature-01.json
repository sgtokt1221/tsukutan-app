          "en": "The forest in the sea",
          "ja": "海の森は",
          "role": "S"
        },
        {
          "en": "shows",
          "ja": "示しています",
          "role": "V"
        },
        {
          "en": "that quietly.",
          "ja": "そのことを静かに",
