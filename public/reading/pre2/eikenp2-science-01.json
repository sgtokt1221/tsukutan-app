    },
    {
      "ja": "しかし1日を過ぎると、忘れ方はゆっくりになります。",
      "chunks": [
        {
          "en": "But",
          "ja": "しかし",
          "role": "M"
        },
        {
          "en": "after one day",
          "ja": "1日を過ぎると",
          "role": "M"
